prfn _one_blocks_output {source:$A.cells}{p:nat}{before,first,second:$A.cells}
  (a: $Z.BLOCKS(source, p, before, first), b: $Z.BLOCKS(source, p, before, second)): $A.CELLS_EQ(first, second) =
  $Z.blocks_functional(a, b)

prfn _one_block_output {kind:$Z.block_kind}{source:$A.cells}{p:nat}{before,first,second:$A.cells}{first_end,second_end:nat}
  (a: $Z.BLOCK(kind, source, p, before, first, first_end), b: $Z.BLOCK(kind, source, p, before, second, second_end)): [first_end == second_end] $A.CELLS_EQ(first, second) =
  $Z.block_functional(a, b)

prfn _one_slice {source:$A.cells}{start,width:nat}{first,second:$A.cells}
  (a: $Z.SLICE(source, start, width, first), b: $Z.SLICE(source, start, width, second)): $A.CELLS_EQ(first, second) =
  $Z.slice_functional(a, b)
